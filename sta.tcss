/* ---- Global ---- */
Screen {
    background: $sta-bg;
}

Header {
    background: $sta-panel;
    color: $sta-fg;
}

Footer {
    background: $sta-panel;
}

Button {
    margin: 0 1 0 0;
    min-width: 14;
}

Input, Select {
    margin-bottom: 1;
}

Label {
    color: $sta-text-muted;
}

.action-row {
    height: auto;
    align: left middle;
}

#actions,
#detail-actions,
#form-actions,
#rel-actions,
#sheet-actions,
#wizard-actions,
#pending-rel-actions,
#attack-actions,
#special-actions,
#wiz-attack-actions,
#wiz-special-actions,
#initiative-actions,
#hp-actions,
#turn-advance-actions,
#roll-ability-actions,
#roll-attack-actions,
#attack-roll-actions,
#export-actions,
#delrel-actions {
    height: auto;
    align: left middle;
}

#backup-status,
#restore-status,
#vault-import-status,
#ddb-import-status,
#csv-import-status,
#export-status,
#wizard-error,
#roll-result {
    min-height: 1;
}

/* ---- Dashboard ---- */
#dashboard {
    padding: 2 4;
    height: 1fr;
}

#title {
    text-align: center;
    color: $sta-accent;
    text-style: bold;
    margin-bottom: 2;
    padding: 1;
    border: solid $sta-accent;
}

#cards {
    layout: grid;
    grid-size: 3 3;
    grid-gutter: 1 2;
    height: auto;
    margin-bottom: 2;
}

.card {
    height: 5;
    content-align: center middle;
    background: $sta-panel;
    border: solid $sta-border;
    text-align: center;
}

.card:hover {
    background: $sta-border;
}

#actions {
    align: center middle;
    height: auto;
}

#actions Button {
    min-width: 16;
}

/* ---- Entity List ---- */
#list-container {
    height: 1fr;
    padding: 1 2;
}

#list-toolbar {
    height: auto;
    margin-bottom: 1;
    align: left middle;
}

#list-toolbar Input {
    width: 1fr;
    margin-right: 1;
}

#list-toolbar Button {
    min-width: 18;
}

DataTable {
    height: 1fr;
    background: $sta-panel;
}

/* ---- Relationship Browser ---- */
#relationship-browser {
    height: 1fr;
    padding: 1 2;
    background: $sta-panel;
}

#relationship-toolbar {
    height: auto;
    margin-bottom: 1;
    align: left middle;
}

#relationship-toolbar Select {
    width: 40;
    margin-right: 1;
}

/* ---- Entity Detail ---- */
#detail-scroll {
    height: 1fr;
    padding: 1 2;
    background: $sta-panel;
}

#detail-actions {
    height: auto;
    padding: 1 2;
    align: left middle;
    background: $sta-bg;
}

#detail-actions Button {
    min-width: 16;
}

/* ---- Entity Form ---- */
#form-scroll {
    height: 1fr;
    padding: 1 2;
}

#form-fields {
    height: auto;
}

#form-fields Label {
    margin-top: 1;
}

#form-fields Input {
    width: 1fr;
}

#form-fields Select {
    width: 1fr;
}

#form-fields TextArea {
    height: 10;
    width: 1fr;
}

#pending-rel-actions {
    margin-top: 1;
}

#form-fields ListView {
    height: 6;
    margin-top: 1;
    background: $sta-bg;
    border: solid $sta-border;
}

#form-actions {
    padding: 1 2;
    background: $sta-bg;
}

/* ---- Relationship Form ---- */
#rel-scroll {
    height: 1fr;
    padding: 1 2;
}

#rel-form {
    height: auto;
}

#rel-form Label {
    margin-top: 1;
}

#rel-form Select {
    width: 1fr;
}

#rel-form Input {
    width: 1fr;
}

#rel-actions {
    padding: 1 2;
}

/* ---- Delete Rel ---- */
#delrel-container {
    padding: 1 2;
    height: 1fr;
}

#delrel-container ListView {
    height: 1fr;
    margin: 1 0;
    background: $sta-bg;
    border: solid $sta-border;
}

#delrel-actions Button {
    min-width: 18;
}

/* ---- Confirm Modal ---- */
#confirm-box {
    width: 50;
    height: auto;
    padding: 2;
    background: $sta-panel;
    border: solid $sta-accent;
    align: center middle;
}


#confirm-box Static {
    margin-bottom: 1;
    text-align: center;
}

#confirm-box Horizontal {
    height: auto;
    align: center middle;
}

ConfirmScreen {
    align: center middle;
    background: rgba(0,0,0,0.7);
}

/* ---- Quick Capture Modal ---- */
QuickCaptureModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}

#qc-box {
    width: 70;
    height: auto;
    max-height: 36;
    padding: 2 3;
    background: $sta-panel;
    border: solid $sta-accent;
}

#qc-header {
    text-style: bold;
    margin-bottom: 1;
    color: $sta-accent;
}

#qc-tag-hint {
    color: $sta-text-hint;
    margin-top: 1;
}

#qc-box Label {
    margin-top: 1;
    color: $sta-text-muted;
}

#qc-box Input {
    width: 1fr;
    margin-bottom: 0;
}

#qc-entity-list {
    height: 6;
    margin-top: 1;
    background: $sta-bg;
    border: solid $sta-border;
}

#qc-status {
    min-height: 1;
    margin-top: 1;
}

#qc-actions {
    height: auto;
    align: left middle;
    margin-top: 1;
}

/* ---- Campaign Switcher ---- */
#campaign-scroll {
    height: 1fr;
}

#campaign-container {
    padding: 2 4;
    height: auto;
}

#campaign-title, #new-campaign-title {
    text-style: bold;
    color: $sta-accent;
    margin-bottom: 1;
}

#new-campaign-title {
    margin-top: 2;
}

#campaign-table {
    height: 10;
    margin-bottom: 1;
    background: $sta-panel;
}

#campaign-actions {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

#campaign-status {
    min-height: 1;
    margin-bottom: 1;
}

#campaign-container Label {
    margin-top: 1;
}

#campaign-container Input {
    width: 1fr;
}

/* ---- Export ---- */
#export-container {
    padding: 2 4;
    height: 1fr;
}

#export-title {
    text-style: bold;
    color: $sta-success;
    margin-bottom: 2;
}

#export-container Label {
    margin-top: 1;
}

#export-container Input {
    width: 1fr;
}

#export-status {
    margin-top: 1;
}

#export-actions {
    margin-top: 1;
}

#export-actions Button {
    min-width: 16;
}

#export-stats-row {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

#export-stats-row Label {
    margin-top: 0;
    margin-left: 1;
}

/* ---- Global Search ---- */
#global-search-container {
    padding: 1 2;
    height: 1fr;
}

#global-search-container Input {
    margin-bottom: 1;
}

/* ---- Backup / Restore ---- */
#backup-scroll {
    height: 1fr;
}

#backup-container {
    padding: 2 4;
    height: auto;
}

#backup-title, #vault-import-title, #ddb-import-title, #csv-import-title {
    text-style: bold;
    color: $sta-warning;
    margin-bottom: 2;
}

#vault-import-title, #ddb-import-title, #csv-import-title {
    margin-top: 2;
}

#csv-import-actions {
    height: auto;
    align: left middle;
    margin-top: 1;
}

#backup-container Label {
    margin-top: 1;
}

#backup-container Input {
    width: 1fr;
}

#restore-actions, #vault-import-actions {
    height: auto;
    align: left middle;
}

#backup-status, #restore-status, #vault-import-status {
    margin: 1 0;
}

/* ---- Character Sheet ---- */
#sheet-tabs {
    height: 1fr;
}

#abilities-scroll, #combat-scroll, #skills-scroll, #attacks-scroll {
    height: 1fr;
    padding: 1 2;
}

#abilities-fields, #combat-fields, #skills-fields, #attacks-fields {
    height: auto;
}

.save-row, .skill-row {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

/* Ability grid (2 rows × 3 columns) */
.ability-grid-row {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

.ability-cell {
    width: 1fr;
    height: auto;
    align: center top;
    padding: 1 2;
    border: solid $sta-border-soft;
}

.ability-cell-label {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: $sta-info;
}

.ability-input {
    width: 8;
}

.ability-mod {
    width: 100%;
    text-align: center;
    color: $sta-success;
    text-style: bold;
}

.race-bonus-badge {
    width: 10;
    color: $sta-success;
    text-style: bold;
}

.save-label, .skill-label {
    width: 24;
}

.save-bonus, .skill-bonus {
    width: 6;
    margin-left: 2;
    color: $sta-success;
    text-style: bold;
}

#skills-fields Select {
    width: 24;
}

#combat-fields Label {
    margin-top: 1;
}

#combat-fields Input {
    width: 1fr;
}

#combat-fields Static#sheet-prof-bonus {
    color: $sta-success;
    text-style: bold;
}

#combat-fields Input.stat-input,
#form-fields Input.stat-input,
#wizard-step Input.stat-input {
    width: 14;
}

#attack-inputs, #special-inputs {
    height: auto;
    margin-top: 1;
}

#attack-inputs Input, #special-inputs Input {
    width: 1fr;
    margin-right: 1;
}

#attack-actions, #special-actions {
    margin-top: 1;
}

#attack-actions Button, #special-actions Button {
    min-width: 20;
}

#attacks-fields ListView {
    height: 6;
    margin-bottom: 1;
    background: $sta-bg;
    border: solid $sta-border;
}

#attacks-fields Static {
    margin-top: 1;
}

#sheet-actions {
    padding: 1 2;
    background: $sta-bg;
}

#sheet-actions Button {
    min-width: 18;
}

/* ---- Roll Picker ---- */
#roll-tabs {
    height: 1fr;
}

#roll-ability-scroll, #roll-skill-scroll, #roll-attack-scroll, #roll-custom-scroll {
    height: 1fr;
}

#roll-ability-fields, #roll-skill-fields, #roll-attack-fields, #roll-custom-fields {
    height: auto;
    padding: 1 2;
}

#roll-ability-fields Label, #roll-skill-fields Label, #roll-attack-fields Label, #roll-custom-fields Label {
    margin-top: 1;
}

#roll-ability-fields Select, #roll-skill-fields Select, #roll-attack-fields Select {
    width: 1fr;
}

#roll-custom-fields Input {
    width: 1fr;
}

#roll-ability-mode, #roll-skill-mode, #roll-attack-mode {
    height: auto;
    align: left middle;
    margin-top: 1;
}

#roll-ability-mode Label, #roll-skill-mode Label {
    margin-right: 2;
    margin-top: 0;
}

#roll-ability-actions, #roll-attack-actions {
    margin-top: 1;
}

#roll-ability-actions Button, #roll-attack-actions Button {
    min-width: 20;
}

#roll-output {
    height: auto;
    max-height: 12;
    padding: 1 2;
    background: $sta-panel;
    border: solid $sta-border;
}

#roll-result {
    margin-bottom: 1;
}

#roll-history {
    height: 8;
    background: $sta-bg;
    border: solid $sta-border;
}

/* ---- Combat Tracker ---- */
#combat-tabs {
    height: 1fr;
}

#combatants-scroll, #hp-conditions-scroll, #turn-controls-scroll {
    height: 1fr;
}

#combatants-fields, #hp-conditions-fields, #turn-controls-fields {
    height: auto;
    padding: 1 2;
}

#combatants-fields Label, #hp-conditions-fields Label {
    margin-top: 1;
}

#combatants-fields Select, #hp-conditions-fields Select {
    width: 1fr;
}

#combatants-fields Input, #hp-conditions-fields Input {
    width: 1fr;
}

#initiative-actions, #hp-actions, #turn-advance-actions, #attack-roll-actions {
    margin-top: 1;
}

#initiative-actions Button, #hp-actions Button, #turn-advance-actions Button, #attack-roll-actions Button {
    min-width: 18;
}

#attack-roll-mode {
    height: auto;
    align: left middle;
    margin-top: 1;
}

#attack-roll-mode Label {
    margin-top: 0;
    margin-right: 2;
}

#attack-roll-result {
    margin: 1 0;
    color: $sta-success;
    text-style: bold;
}

#turn-controls-fields Button {
    width: 1fr;
    margin-top: 1;
}

#hp-conditions-fields ListView {
    height: 6;
    margin-top: 1;
    margin-bottom: 1;
    background: $sta-bg;
    border: solid $sta-border;
}

#balance-readout {
    margin-top: 2;
    padding: 1;
    background: $sta-panel;
    border: solid $sta-border;
    min-height: 3;
}

#condition-desc {
    color: $sta-info;
    margin-bottom: 1;
    min-height: 2;
}

#death-save-section {
    margin-top: 2;
    padding: 1;
    border: solid $sta-danger;
    background: $sta-bg-danger;
}

#death-save-heading {
    text-style: bold;
    color: $sta-danger;
    margin-bottom: 1;
}

#death-save-status {
    color: $sta-success;
    margin-bottom: 1;
}

#death-save-actions {
    height: auto;
    align: left middle;
}

#combat-summary-scroll {
    height: auto;
    max-height: 14;
    padding: 1 2;
    background: $sta-panel;
    border: solid $sta-border;
}

/* ---- Active Effects ---- */
#effects-scroll {
    height: 1fr;
    padding: 1 2;
}

#effects-fields {
    height: auto;
}

#effects-fields Label {
    margin-top: 1;
}

#effects-fields Input, #effects-fields Select {
    width: 1fr;
}

#effects-fields ListView {
    height: 8;
    margin-top: 1;
    margin-bottom: 1;
    background: $sta-bg;
    border: solid $sta-border;
}

/* ---- Session Workflow ---- */
#session-workflow-scroll {
    height: 1fr;
    padding: 1 2;
}

.workflow-heading {
    text-style: bold;
    color: $sta-text-muted;
    margin-top: 1;
}

#session-workflow-scroll DataTable {
    height: 6;
    margin-bottom: 1;
}

#wf-pc-actions {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

#wf-pc-actions Button {
    min-width: 20;
}

/* ---- Creation Wizard ---- */
#wizard-scroll {
    height: 1fr;
    padding: 1 2;
}

#wizard-step {
    height: auto;
}

#wizard-step Label {
    margin-top: 1;
}

#wizard-step Input, #wizard-step Select {
    width: 1fr;
}

#wizard-step ListView {
    height: 6;
    margin-top: 1;
    margin-bottom: 1;
    background: $sta-bg;
    border: solid $sta-border;
}

#wiz-attack-inputs Input, #wiz-special-inputs Input {
    width: 1fr;
    margin-right: 1;
}

#wiz-attack-actions, #wiz-special-actions {
    margin-top: 1;
}

#wiz-attack-actions Button, #wiz-special-actions Button {
    min-width: 20;
}

#wiz-review-summary {
    margin: 1 0;
    background: $sta-panel;
    border: solid $sta-border;
    padding: 1 2;
}

#wizard-actions {
    padding: 1 2;
    background: $sta-bg;
}

#wizard-error {
    color: $sta-danger;
    margin-bottom: 1;
}

.wiz-class-hint {
    color: $sta-success;
    margin-bottom: 1;
}

#wizard-nav {
    height: auto;
}

#wizard-nav Button {
    min-width: 18;
}

/* ── Spells tab ────────────────────────────────────────────────────── */

#spell-stats {
    background: $sta-border;
    color: $sta-fg-bright;
    padding: 0 2;
    margin-bottom: 1;
}

.slot-row {
    height: 1;
    align: left middle;
    margin-bottom: 0;
}

.slot-label {
    width: 6;
    color: $sta-text-dim;
}

.slot-input {
    width: 6;
    height: 1;
    border: none;
    padding: 0 1;
    background: $sta-input-bg;
}

.slot-sep {
    width: 3;
    text-align: center;
    color: $sta-text-faint;
}

#spell-form-row1, #spell-form-row2 {
    height: auto;
    align: left middle;
    margin-top: 1;
}

#spell-name {
    width: 1fr;
}

#spell-level {
    width: 16;
}

#spell-action-cost {
    width: 20;
}

#spell-save-or-attack {
    width: 18;
}

#spell-save-ability {
    width: 18;
}

#spell-description {
    width: 1fr;
}

#spell-actions {
    height: auto;
    align: left middle;
    margin: 1 0;
}

#list-spells {
    height: auto;
    min-height: 4;
    max-height: 14;
    background: $sta-panel;
    border: solid $sta-border;
}

/* ── Rest screen ───────────────────────────────────────────────────── */

.rest-section-heading {
    color: $sta-success;
    margin-top: 1;
    margin-bottom: 0;
}

.rest-desc {
    color: $sta-text-faint;
    margin-bottom: 1;
}

.rest-result {
    margin-left: 2;
}

.rest-pc-block {
    height: auto;
    background: $sta-panel;
    border: solid $sta-border;
    padding: 0 1;
    margin-bottom: 1;
}

.rest-pc-header {
    height: auto;
    align: left middle;
    margin-bottom: 0;
}

.rest-pc-name {
    width: 22;
}

.rest-pc-stats {
    color: $sta-text-dim;
}

.rest-slots {
    color: $sta-info;
    margin-bottom: 0;
}

.rest-dice-input {
    width: 6;
    height: 1;
    border: none;
    padding: 0 1;
    background: $sta-input-bg;
}

#short-rest-roster {
    height: auto;
}

#short-rest-roster Horizontal {
    height: auto;
    align: left middle;
}

/* ── Party Overview ─────────────────────────────────────────────────────── */

#overview-wrap {
    margin: 1 2;
    padding: 1;
    border: solid $sta-border-accent;
    height: 1fr;
}

#overview-status {
    height: auto;
    color: $sta-info;
    margin-bottom: 1;
}

#party-table {
    height: 1fr;
    background: $sta-panel-deep;
}

/* ── Award XP ───────────────────────────────────────────────────────────── */

#xp-wrap {
    margin: 1 2;
    padding: 1;
    border: solid $sta-border-accent;
    height: auto;
}

#xp-heading {
    text-style: bold;
    margin-bottom: 1;
}

#xp-input-row {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

#xp-input-row Label {
    width: 18;
}

.xp-amount-input {
    width: 16;
}

#xp-split-label {
    height: auto;
    margin-bottom: 1;
    color: $sta-info;
}

#xp-roster-heading {
    height: auto;
    margin-bottom: 0;
}

#xp-roster-scroll {
    height: auto;
    max-height: 12;
}

#xp-roster {
    height: auto;
    background: $sta-panel-deep;
    border: solid $sta-border-dim;
}

#xp-actions {
    height: auto;
    align: left middle;
    margin-top: 1;
}

#xp-result {
    height: auto;
    margin-top: 1;
}

/* ── Monster Reference ──────────────────────────────────────────────────── */

#monster-split {
    height: 1fr;
    margin: 1 2 0 2;
    border: solid $sta-border-danger;
}

#monster-left {
    width: 32;
    border-right: solid $sta-border-danger;
    padding: 0 1;
}

#monster-left Input {
    height: 3;
    margin-bottom: 1;
}

#monster-list {
    height: 1fr;
    background: $sta-panel-deep;
    border: none;
}

#monster-right {
    width: 1fr;
    padding: 1 2;
    background: $sta-panel-deep;
}

#monster-detail {
    height: auto;
}

#monster-actions {
    height: auto;
    align: left middle;
    margin: 0 2 1 2;
    padding-top: 1;
}

/* ================================================================== */
/* LCARS layout idioms                                                */
/* ------------------------------------------------------------------ */
/* ---- Keyboard help overlay (?) ---- */
HelpScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}

#help-box {
    width: 64;
    height: auto;
    max-height: 40;
    padding: 1 3;
    background: $sta-panel;
    border: solid $sta-accent;
}

#help-title {
    text-style: bold;
    color: $sta-accent;
    margin-bottom: 1;
}

#help-body {
    height: auto;
    max-height: 30;
}

#help-hint {
    color: $sta-text-hint;
    margin-top: 1;
}

.help-group {
    text-style: bold;
    color: $sta-text-muted;
    margin-top: 1;
}

.help-row {
    color: $sta-fg;
}

/* ---- Quick Task roll (ctrl+r) ---- */
QuickTaskModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}

#qt-box {
    width: 78;
    height: auto;
    max-height: 30;
    padding: 1 3;
    background: $sta-panel;
    border: solid $sta-accent;
}

#qt-header {
    text-style: bold;
    color: $sta-accent;
    margin-bottom: 1;
}

#qt-body {
    height: auto;
    max-height: 20;
}

/* Unconstrained, the Difficulty input eats the row and pushes the Focus and
   Invoke switches off the edge of the modal. */
#qt-difficulty {
    width: 8;
}

#qt-params Switch {
    margin-left: 2;
}

#qt-selectors, #qt-params, #qt-dice-params, #qt-actions {
    height: auto;
    margin-top: 1;
}

#qt-params Label, #qt-dice-params Label {
    margin: 1 1 0 1;
    color: $sta-text-muted;
}

#qt-result {
    margin-top: 1;
}

#qt-pools {
    margin-top: 1;
    color: $sta-text-hint;
}

/* Only active under the sta-lcars theme: STAApp adds the -theme-lcars */
/* class (see app.watch_theme) whenever that theme is selected, so     */
/* these rules never touch the sta-dark / sta-light look. Terminals    */
/* can't draw LCARS elbow sweeps, and Textual CSS has no text-transform */
/* for true ALL-CAPS -- so the flavor here is round orange framing and */
/* right-justified amber headers. Each rule keeps the element's own    */
/* border color variable and only swaps the border style to round.     */

/* Round framing on the prominent panels (orange frames). */
App.-theme-lcars #title,
App.-theme-lcars .card,
App.-theme-lcars #confirm-box,
App.-theme-lcars #qc-box,
App.-theme-lcars #help-box,
App.-theme-lcars #qt-box,
App.-theme-lcars #roll-output,
App.-theme-lcars #roll-history,
App.-theme-lcars #balance-readout,
App.-theme-lcars #combat-summary-scroll,
App.-theme-lcars #wiz-review-summary,
App.-theme-lcars .rest-pc-block {
    border: round $sta-border;
}

/* Accent-framed wraps keep their violet edge, rounded. */
App.-theme-lcars #overview-wrap,
App.-theme-lcars #xp-wrap {
    border: round $sta-border-accent;
}

/* Danger frames keep their red edge, rounded. */
App.-theme-lcars #death-save-section {
    border: round $sta-danger;
}

App.-theme-lcars #monster-split {
    border: round $sta-border-danger;
}

/* Right-justified headers -- the LCARS reading rhythm. */
App.-theme-lcars #title,
App.-theme-lcars #export-title,
App.-theme-lcars #backup-title,
App.-theme-lcars #vault-import-title,
App.-theme-lcars #ddb-import-title,
App.-theme-lcars #csv-import-title,
App.-theme-lcars #campaign-title,
App.-theme-lcars #new-campaign-title,
App.-theme-lcars #xp-heading,
App.-theme-lcars #qc-header,
App.-theme-lcars #help-title,
App.-theme-lcars #qt-header,
App.-theme-lcars .workflow-heading,
App.-theme-lcars .rest-section-heading {
    text-align: right;
}
